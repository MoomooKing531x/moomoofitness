# Postgres connection string (for production: use your server's PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL="postgresql://fitness_user:YOUR_STRONG_PASSWORD@localhost:5432/fitness_app"

# JWT Secret - generate a random string with: openssl rand -base64 32
# Keep this secret and never share it!
JWT_SECRET="GENERATE_A_RANDOM_32_CHAR_SECRET_HERE"

# Environment
NODE_ENV="production"
